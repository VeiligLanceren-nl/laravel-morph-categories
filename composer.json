{
    "name": "veiliglanceren/laravel-morph-categories",
    "description": "A Laravel package to support polymorphic category relationships for any model.",
    "keywords": ["laravel", "category", "morph", "polymorphic", "taxonomy"],
    "homepage": "https://github.com/veiliglanceren-nl/laravel-morph-categories",
    "support": {
        "issues": "https://github.com/veiliglanceren/laravel-morph-categories/issues",
        "source": "https://github.com/veiliglanceren/laravel-morph-categories"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "3.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "spatie/laravel-sluggable": "^3.0|^4.0",
        "laravel/framework": "^12.0|^13.0",
        "ext-dom": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "VeiligLanceren\\LaravelMorphCategories\\": "src/"
        },
        "files": [
            "src/Support/Helpers/models.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Niels Hamelink"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VeiligLanceren\\LaravelMorphCategories\\MorphCategoryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
